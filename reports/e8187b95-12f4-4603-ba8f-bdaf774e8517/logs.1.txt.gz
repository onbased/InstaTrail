e":"activity_type","id":"e310caea-216e-4fa8-af02-5855ed31a47d","name_en":"Run","name_hu":"Futva","material_icon_name":"run","weight":30},"reward_type":{"__typename":"reward_type","id":"dd2701a9-52da-42a5-b0d2-78c00b872452","name_en":"Fame","name_hu":"Hírnév","material_icon_name":"flowerOutline","weight":10}}, {"__typename":"trail_config","id":"bd503a27-9c94-4759-9421-c20260690c09","trail_id":"a9d5ba8c-6291-4fcc-9d9a-3e130c1818b9","completion_note":"","limit_seconds":36600,"pricing":0,"approve_required":false,"activities":[{"__typename":"activity","id":"2007edf5-e97d-45bd-b1a7-59503d8ac933"}],"activity_type":{"__typename":"activity_type","id":"f602d0e2-56d7-439f-a2a3-61ff0fb6e8a2","name_en":"Hike","name_hu":"Túrázva","material_icon_name":"walk","weight":10},"reward_type":{"__typename":"reward_type","id":"dd2701a9-52da-42a5-b0d2-78c00b872452","name_en":"Fame","name_hu":"Hírnév","material_icon_name":"flowerOutline","weight":10}}]}, {"__typename":"trail","pending_reviews_total":0,"id":"1d177444-2eba-4679-b819-9322079b68ff","name":"Sunset e-Trail","checkpoints":[{"__typename":"checkpoint","id":"c1b59fa8-eca7-4926-90bc-07f7558f5ea3","name":"Rajt/Cél","index":0,"location":{"type":"Point","crs":{"type":"name","properties":{"name":"urn:ogc:def:crs:EPSG::4326"}},"coordinates":[18.3167651,47.4870381,0]},"range_meters":100,"checkpoint_file":null}, {"__typename":"checkpoint","id":"f7da87ee-69ab-4b95-8131-c6fb1de23e23","name":"1.Majk","index":1,"location":{"type":"Point","crs":{"type":"name","properties":{"name":"urn:ogc:def:crs:EPSG::4326"}},"coordinates":[18.3369461,47.4963718,0]},"range_meters":100,"checkpoint_file":null}, {"__typename":"checkpoint","id":"8378c273-5be9-4bb1-b2e7-c545eaff4bbd","name":"2. Várgesztes vár","index":2,"location":{"type":"Point","crs":{"type":"name","properties":{"name":"urn:ogc:def:crs:EPSG::4326"}},"coordinates":[18.3953056,47.4683078,0]},"range_meters":100,"checkpoint_file":null}, {"__typename":"checkpoint","id":"d2167861-07c0-4b62-8ae5-69a5483fa034","name":"3. Vérteskozma","index":4,"location":{"type":"Point","crs":{"type":"name","properties":{"name":"urn:ogc:def:crs:EPSG::4326"}},"coordinates":[18.4429684,47.4565681,0]},"range_meters":100,"checkpoint_file":null}, {"__typename":"checkpoint","id":"a94b7217-2ac3-40e8-b361-1609e905f367","name":"4.Várgesztes kelet","index":5,"location":{"type":"Point","crs":{"type":"name","properties":{"name":"urn:ogc:def:crs:EPSG::4326"}},"coordinates":[18.4089446,47.4732648,0]},"range_meters":100,"checkpoint_file":null}, {"__typename":"checkpoint","id":"e52f1863-fefe-47cd-93f6-15b50e69b4ff","name":"5. Körtvélyespuszta","index":6,"location":{"type":"Point","crs":{"type":"name","properties":{"name":"urn:ogc:def:crs:EPSG::4326"}},"coordinates":[18.4445268,47.511679,0]},"range_meters":100,"checkpoint_file":null}, {"__typename":"checkpoint","id":"9235adf0-9071-40e5-ba43-a1b4e6cb7140","name":"Szarvas kút forrás","index":8,"location":{"type":"Point","crs":{"type":"name","properties":{"name":"urn:ogc:def:crs:EPSG::4326"}},"coordinates":[18.411042183488785,47.50396809878707,0]},"range_meters":100,"checkpoint_file":null}, {"__typename":"checkpoint","id":"f43a6ea8-0702-435b-8c9e-920c04844bd8","name":"6. Nagy-Somló kilátó","index":10,"location":{"type":"Point","crs":{"type":"name","properties":{"name":"urn:ogc:def:crs:EPSG::4326"}},"coordinates":[18.3717021,47.5175594,0]},"range_meters":100,"checkpoint_file":null}],"summary":"Légy gyorsabb a napnál! 42-km-es eTrail a Vértesben.","description":"[{\"insert\":\"Egy okostelefon segítségével bármikor teljesíthető. Egy fontos szabály azért van. Érj be még napnyugta előtt! Nem bonyolult ugye? Na azért olvasd el a tudnivalókat indulás előtt.\\n\\nTUDNIVALÓK\"},{\"insert\":\"\\n\\n\",\"attributes\":{\"header\":2}},{\"insert\":\"A Sunset eTrail, egy terepfutó „verseny” a Vértesben. Indulni csak napkelte után lehet és napnyugtáig be kell érni. Azaz csak nappal teljesítheted.\\nTáv: 42 km\\nSzint: 1000 m\\nSzintidő: max. 7 óra\\n\\n\\nAz útvonal turistautakon és jelölt útvonalon halad. A teljes útvonalat be kell járnod a meghatározott útvonal alapján. Az ellenőrzőpontokat a megadott sorrendben kell érintened. Pont kihagyása, rossz pont sorrend, vagy szintdőntúli beérkezés esetén a teljesítés nem érvényes. Az eredmény táblázatban \\\"Feladta\\\", vagy „Szintidőn kívül” fog szerepelni a név mellett. Útközben frissíthet bárki, bárhol. Kerékpáros kísérő megengedett. \\n\\nA Sunset eTrail-en csak regisztráció és nevezést követően lehet indulni. (14 év alattiaknak nem indulhatnak, 18 év alattiak csak nagykorú felügyeletével). Ha már van VérKör regisztrációd akkor regisztrálnod sem kell. Teljesíthető egyénileg, de csapatban is. Ilyenkor minden csapattagot regisztrálni és nevezni kell. Csak megfelelő erőnléttel és tájékozódási képességgel rendelkezők indulhatnak (Bővebben: GYIK)! \\n\\nTeljesítéshez szükséges egy okostelefon, amely alkalmas QR kód olvasására és van rajta mobil internet előfizetés. A Trail-en ellátás nincs, minden felszerelést magaddal kell vinni. A QR kódokat fákon találod. A fákra szemmagasságban piros S betűket festettünk melyek jól látszanak a turistautakról. A kódok a fák hátulján változatos helyeken vannak (gyakran térdmagasságban) . A kódok leolvasásakor a rendszer regisztrálja a pontos időt. \\n\\nA rajt/cél Oroszlányon a Sportcsarnoknál a nagy lépcsővel szemben található (Szent Borbála tér 2.). A Sportcsarnok a négysávos út melletti Polgármesteri Hivatal (Rákóczi Ferenc út 78.)mögött van. A Sportcsarnok mellett tágas, ingyenes parkoló van a rendőrség szomszédságában. Ha vasúttal érkeznél az állomástól 700 m-re találod a rajtot. A sportcsarnok ajtaja melletti ablaknál (vagy a csarnok mögött az uszoda jobb oldalán, a mozgássérült lift mellett) tudod leolvasni az induláshoz szükséges kódot és mellette találod a célba éréskor leolvasandót. A rajt kód leolvasása után már indulhatsz is!\\n\\nVízvételi lehetőségek: Várgesztes (kitérő), Vérteskozma kút, Szép-Ilonka forrás, (Béla-forrás), (Szarvas-kút), Vértessomló, Majk kút\\n\\nA sikeres teljesítéshez szükséges lépések: \\n1. Regisztráció\\n2. Nevezés \\n3. Oroszlányban a Sportcsarnoknál leolvasni a Rajt kódot és megnyitni a weblapot. \\n4. A megadott útvonalat bejárni az összes pont érintésével szintidőn belül. A pontokon a kódokat leolvasni a telefonnal és megnyitni a weblapot. \\n5. A Cél kódot leolvasni (szintén a Sportcsarnoknál) és megnyitni a weblapot.\\n\\nAjánlott felszerelés:\\n- mobiltelefon (QR kód olvasásására alkalmas + mobil internet előfizetés) \\n- gps\\n- Cartographia Vértes turistatérkép \\n- esőkabát \\n- 1 liter víz \\n- 3-5 csoki vagy gél \\n\"}]","deleted_at":null,"summary_path":"}xy`H_oxnBeGc@k@]oAgCLqBsAaCsGoDkIcFlF{R?@fBiIwKyGmOmJqCcBuHiPbHqMtCqEgEeFjBeE|HyApGsChBqE\\mCjBgOp@{CdDwBj@{DVaB|DeIt@qChAoGMw@{@eDgA{DrCaEDs@vDsF|AeB|H_LlQeWzDwFhAkAvFkJtCsDrGkJpB}CdBiCkDcN`CmJnCiFlEwH|C}FtGyHrGyFxJ{J`Ha\\zCoPnAwK?aAnAqTNiBEmFeA}E}DbIc@jCb@kC|DcIdA|EDlFW~BmCpDoCXcDeBuJwNOyAYqItEwGbHoHrEoJr@gAxBqChBuExAuLlB{G|D}EzBoElFuK~A{BVaAN{Bf@yAx@_GXoEFeBh@aELq@jBuGl@yFnBeMrEsOrBwJjA{Dz@iCB{@g@{CEo@@q@ViCpDgGtBiExEgHxDgFyCyGyD_HgCqF_AcD\\mBz@oCfAoCoDsHsAyFe@n@yNdSw@r@aCfA}@Hs@C]fCmIvKkCjIa@pBSlBaAhOgApGk@dGSnE[tK?|EJhBl@lHkA`EEjBHlAJvBaCrDuG|JcDtEuIjW}DxGwDtQ}EjImB~F]~@i@oDyFgHwBw@oFkB{EcE]D{FYoIcBwF{LeA~Bg@wAyDaGeGcGyDyCIk@RyBgAaPeFaB_EaEy@gBeAoB@_AMoCsGsAcBKcKwEeDy@c@W{C|C_EgEmGvCaFpB}CwFsAoAQAwDzByJpBiFuB@?sN_OCK\\c@{AyFyAiFm@{KUmHd@aGLuDKsA?@SqKLu@ReA^qGAiEM_GvDeBaB}Dw@wBqHeIyDhDyBhEgB`CcD~DoAtAkB|CcFrJyBxDqB~CcAfClBhJd@lJb@dE]lBqBzPr@vHv@lFdClEv@|Gb@|BGhEDZlEfBGxAY`BsG~Jg@lAoD|M@h@SlCc@lFHlS`Bm@fDf@dGaAtA[r@UtEUrIvLfGxExEEtKLvIsFbDe@rCQaC|QeIfMc@bPpDlNiM`PmA~A_DpCa@|AwCvAeBnA}BpCgAhBaAbAy@jDQtAqB~E{AxHkE|VqCfI]bDRtCTxB?rCThGh@lHrCpIBnDkF{B]CcBTgFfD_CdDkD|FiBOaLfCe@n@eBhAjAzDA`@YxCCnADPtBe@uBd@EQBoAXyC@a@kA{DdBiAd@o@`LgCdBNnD}F~BeDfFgDbBUlDt@`ExDz@pA`BfM|DfSPExBxIlAm@hBdBcAR@T~@nCjApEt@HrGnF\\dAj@z@t@|AnIjOrFnOa@zE{AlIOpACfE@pGk@bJi@dEPlBUvCHpD?dEGbA]tF?hEl@|EfB~Ft@~Fs@tBf@`@zAlClDvHbAdLp@dCnExJlCdG~Hx