}}, {"__typename":"trail_config","id":"4d817f6a-96e9-4094-a39c-f2ba54f2344d","trail_id":"5de10c88-c019-496b-900a-ff54117cd01f","completion_note":"","limit_seconds":13800,"pricing":0,"approve_required":false,"activities":[],"activity_type":{"__typename":"activity_type","id":"f602d0e2-56d7-439f-a2a3-61ff0fb6e8a2","name_en":"Hike","name_hu":"Túrázva","material_icon_name":"walk","weight":10},"reward_type":{"__typename":"reward_type","id":"dd2701a9-52da-42a5-b0d2-78c00b872452","name_en":"Fame","name_hu":"Hírnév","material_icon_name":"flowerOutline","weight":10}}]}, {"__typename":"trail","pending_reviews_total":0,"id":"0335dfd8-65e6-4d0c-af9d-cc63cf129f33","name":"Budapest - Cseresznyefa virágzás - Hanami","checkpoints":[{"__typename":"checkpoint","id":"ecbfc7f6-045d-4859-b16d-5bf769acfc71","name":"Tóth Árpád sétány","index":0,"location":{"type":"Point","crs":{"type":"name","properties":{"name":"urn:ogc:def:crs:EPSG::4326"}},"coordinates":[19.03122199163206,47.50109125931849,0]},"range_meters":20,"checkpoint_file":null}, {"__typename":"checkpoint","id":"268e86fe-175a-40f1-a185-1575ea09bb22","name":"Budai Arborétum","index":1,"location":{"type":"Point","crs":{"type":"name","properties":{"name":"urn:ogc:def:crs:EPSG::4326"}},"coordinates":[19.03963566845602,47.48189326414164,0]},"range_meters":20,"checkpoint_file":null}, {"__typename":"checkpoint","id":"772e6cce-619a-440b-8087-75d4beb6cfcc","name":"ELTE Füvészkert","index":2,"location":{"type":"Point","crs":{"type":"name","properties":{"name":"urn:ogc:def:crs:EPSG::4326"}},"coordinates":[19.085265794545062,47.4838596206675,0]},"range_meters":20,"checkpoint_file":null}, {"__typename":"checkpoint","id":"b86f1080-0aec-4de7-9317-102a23fbfd0a","name":"Zuglói Japánkert","index":3,"location":{"type":"Point","crs":{"type":"name","properties":{"name":"urn:ogc:def:crs:EPSG::4326"}},"coordinates":[19.12012392729831,47.510660933219995,0]},"range_meters":20,"checkpoint_file":null}],"summary":null,"description":"[{\"insert\":\"Hanami Budapesten\"},{\"insert\":\"\\n\",\"attributes\":{\"header\":1}},{\"insert\":\"\\nHamarosan megérkezik a tavasz egyik leggyönyörűbb természeti jelensége a cseresznyefa virágzása. Ez az esemény egyben Japán kulturális szimbóluma is, melynek ünnepe hosszú évszázadokra vezethető vissza, de manapság már a világ szinte összes részén ünneplik. A következőkben röviden bemutatjuk ennek az eredetét és hogy Budapest környékén mi hol tudunk részesei lenni.\\n\\n\"},{\"insert\":\"A cseresznyevirágzás\",\"attributes\":{\"underline\":true}},{\"insert\":\"\\n\",\"attributes\":{\"header\":2}},{\"insert\":\"\\nA cseresznyefa virága, a sakura, Japán nemzeti jelképe és egy hosszabb ünnep, a Hanami keretein belül ünneplik meg. Az ünnep során az emberek kimennek a közeli cseresznyefa-ligetekbe, piknikeznek, és élvezik a gyönyörű virágok látványát. \\n\\nRégebben a sakura segített az ültetési és betakarítási szezon előrejelzésében. Emiatt Japánban a cseresznyefa virágzásának kezdetét a megújulás jelképének tekintik. Maguk a virágok meddők, azaz nem hoznak gyümölcs termést, valamint rövid élettartammal rendelkeznek, emiatt gyakran hasonlítják az élet múlékony természetéhez is. Sok ember számára tehát, a Hanami az újjászületés és a halandóság körforgását szimbolizálja.\\n\\nÉs hogy merre induljatok el a fővárosban, hogy meg tudjátok csodálni a cseresznyevirágzást? Az alábbiakban néhány helyszínt gyűjtöttünk össze, ahol szerintünk ezt legjobban megtehetitek.\\n\\n\"},{\"insert\":\"Tóth Árpád sétány\",\"attributes\":{\"underline\":true}},{\"insert\":\"\\n\",\"attributes\":{\"header\":2}},{\"insert\":\"\\nKezdjük egy klasszikus és a talán leglátványosabb helyszínnel, a Tóth Árpád sétánnyal. Azt biztosra mondhatjuk, hogy ebben az időszakban ez Várnegyed legvonzóbb sétaútvonala. A sétány a várfal mellett haladó Bástya sétány része, a Várnegyed Attila út felőli részén találjuk, egyik végpontja az Anjou bástya, a másik pedig a Fehérvári rondella. A panorámás sétányt hosszan éri a napfény és itt láthatjuk a legtöbb fát egy helyen.\\n\\n\"},{\"insert\":\"Budai Arborétum\",\"attributes\":{\"underline\":true}},{\"insert\":\"\\n\",\"attributes\":{\"header\":2}},{\"insert\":\"\\nMásodikként egy már túrásabb helyszínt, a Gellért-hegy déli lábánál elterülő Budai Arborétumot ajánljuk. A kert legnagyobb cseresznyefája a legelterjedtebb Kanzan fajta képviselője, de találhatunk itt hasonlóan szép díszalmákat is, amelyeket a japáncseresznye-gyűjteménnyel egyszerre telepítettek. Színpompás virágzásuk március végétől egészen május közepéig tart. Ha leleményesek vagyunk az arborétum közelében, a Feneketlen-tóval szemben, a Szent Imre-templom mellett is találkozhatunk egy szép díszcseresznyével.\\n\\n\"},{\"insert\":\"ELTE fűvészkert\",\"attributes\":{\"underline\":true}},{\"insert\":\"\\n\",\"attributes\":{\"header\":2}},{\"insert\":\"\\nA Pál utcai fiúkból is ismert helyszín sok-sok száz növényfajnak ad lakhelyet. Közöttük egészen különlegesek is megtalálhatóak, mint például a páfrányfenyők, liliomfák, orchideák vagy éppen a Sakura fák. Az ELTE Füvészkertben öt díszcseresznye-fajta van, és minden év április közepén Sakura-ünnepet is tartanak, ahol a piknik mellett japán tematikájú programokkal is várják a látogatókat.\\n\\n\"},{\"insert\":\"Zuglói Japánkert\",\"attributes\":{\"underline\":true}},{\"insert\":\"\\n\",\"attributes\":{\"header\":2}},{\"insert\":\"\\nZugló csodakertjében szinte kötelező elem a japán díszcseresznye, hisz egy japánkertben járunk. Az itteni fák többsége még kicsi, de már most gyönyörűen pompáznak. 1931-ben a Magyarországra látogató Takamcu herceg és felesége, a japán császári család tagjai, hazatértük után ajándéknövényeket küldtek hazánknak. Ide, a japánkertbe is került néhány, amelyek közül egy idős japán díszcseresznye ma is látható a kertben.\\n\"}]","deleted_at":null,"summary_path":"}p|`H_`dsB~AsDn@q@zBxCTApA|BPe@pEfIrDcJdC`AnBfFhFlF~NsHvBu@lDKlEGxFuCh@kAfCEr@mAlBC`BeCXeGbAaF`KaVhAkAp@{AnB~AlAlAcFqF|DyKvDuFbAgC@uCSqCoAIi@gCdCsGBgAg@o@qAEeCH{AUP